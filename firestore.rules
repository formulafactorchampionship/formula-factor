rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pilotos/{pilotId} {
      allow read: if true;
      allow write: if request.resource.data.keys().size() > 0;
    }
    match /carreras/{raceId} {
      allow read: if true;
      allow write: if request.resource.data.keys().size() > 0;
    }
    match /configuracion/{configId} {
      allow read: if true;
      allow write: if request.resource.data.keys().size() > 0;
    }
    match /usuarios/{userId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.email is string && request.resource.data.email.size() <= 120;
    }
    match /fantasy_leaderboard/{teamId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.teamName is string && request.resource.data.teamName.size() <= 40 && request.resource.data.teamValue is number && request.resource.data.teamValue <= 85;
    }
    match /fantasy_teams/{teamId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.teamName is string && request.resource.data.teamName.size() <= 40 && request.resource.data.teamValue is number && request.resource.data.teamValue <= 85;
    }
    match /noticias/{newsId} {
      allow read: if true;
      allow write: if request.resource.data.keys().size() > 0;
    }
    match /noticias_comentarios/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      allow update, delete: if true;
    }
    match /carreras_fotos/{photoId} {
      allow read: if true;
      allow write: if request.resource.data.keys().size() > 0;
    }
  }
}
