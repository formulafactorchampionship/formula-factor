rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pilotos/{pilotId} {
      allow read, write: if true;
    }
    match /carreras/{raceId} {
      allow read, write: if true;
    }
    match /configuracion/{configId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
