rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'enzo.castillo.lomb@gmail.com' ||
        request.auth.token.email.lower() == 'formulafactorchampionship@gmail.com'
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- Verification integrity helpers ---------------------------------
    // A write "asserts verification" when it marks the account verified or links
    // it to an official driver. Only admins, or owners who consumed a claim
    // token, may do that.
    function assertsVerification(data) {
      return (('isVerified' in data) && data.isVerified == true)
          || (('claimedDriver' in data) && data.claimedDriver is string && data.claimedDriver.size() > 0);
    }

    // A verification is only valid when backed by a claim token this user has
    // consumed (pilotos_privado/{code}.usedByUid == uid) for that same driver.
    function claimTokenValid(uid, code, driver) {
      return code is string
        && code.matches('^[A-Za-z0-9_-]{1,60}$')
        && driver is string
        && exists(/databases/$(database)/documents/pilotos_privado/$(code))
        && get(/databases/$(database)/documents/pilotos_privado/$(code)).data.usedByUid == uid
        && get(/databases/$(database)/documents/pilotos_privado/$(code)).data.driver == driver;
    }

    // Owner writes to the PRIVATE account doc: allowed unless they assert
    // verification, in which case they must already be verified or present a
    // valid claim token.
    function privateWriteOk(uid) {
      return !assertsVerification(request.resource.data)
          || (exists(/databases/$(database)/documents/usuarios/$(uid))
              && get(/databases/$(database)/documents/usuarios/$(uid)).data.isVerified == true)
          || claimTokenValid(uid, request.resource.data.claimCode, request.resource.data.claimedDriver);
    }

    // Owner writes to the PUBLIC card: verification fields are only accepted when
    // the private account doc is already verified (which is itself gated above).
    function publicWriteOk(uid) {
      return !assertsVerification(request.resource.data)
          || (exists(/databases/$(database)/documents/usuarios/$(uid))
              && get(/databases/$(database)/documents/usuarios/$(uid)).data.isVerified == true);
    }

    // ---------------------------------------------------------------------
    // PUBLIC driver cards. Contains only non-personal data that is meant to
    // be shown on the public website (display name, verified flag, avatar,
    // colours, bio, social links). NEVER store email or password here.
    // Documents are keyed by the Firebase Auth uid (never by email).
    // ---------------------------------------------------------------------
    match /usuarios_publicos/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() || (isSelf(uid) && publicWriteOk(uid));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // PRIVATE account data (email, signup metadata, claimed driver...).
    // Only the account owner or an admin can read it. Listing is admin-only
    // so the collection can never be scraped anonymously.
    // ---------------------------------------------------------------------
    match /usuarios/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (isSelf(uid) && privateWriteOk(uid));
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();
      allow create, update: if isSelf(userId)
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin())
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin != true || isAdmin())
        && (!('password' in request.resource.data))
        && (!('passwordHash' in request.resource.data) || (request.resource.data.passwordHash is string && request.resource.data.passwordHash.size() <= 256));
    }

    // Public driver cards (name, team, points, colours...). Reads are open so
    // the website can render them; writes are admin-only.
    match /pilotos/{pilotId} {
      allow read: if true;
      allow delete, create, update: if isAdmin();
    }

    // Private per-pilot verification data. The document id IS the verification
    // code, so a signed-in user who knows the exact code can read just that
    // token (get) but can never enumerate the collection (list is admin-only).
    // Holds the code and the linked account (email/uid); NEVER expose these on
    // the public 'pilotos' documents.
    match /pilotos_privado/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      // A signed-in user may consume an unused token, binding it to themselves.
      allow update: if isAdmin() || (
        isSignedIn()
        && request.resource.data.usedByUid == request.auth.uid
        && resource.data.usedByUid == null
      );
    }

    match /carreras/{raceId} {
      allow read: if true;
      allow delete, create, update: if isAdmin();
    }

    match /configuracion/{configId} {
      allow read: if true;
      allow delete, create, update: if isAdmin();
    }

    match /noticias/{newsId} {
      allow read: if true;
      allow delete, create, update: if isAdmin();
    }

    // Comments: anyone signed in may post, but only the author (or an admin) may
    // edit or delete their own comment. The author uid is bound to the session.
    match /noticias_comentarios/{commentId} {
      allow read: if true;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if isAdmin() || (isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000);
    }

    // Photos: approved ones are public; pending/rejected are admin-only. Public
    // list queries MUST filter by status == 'approved'.
    match /carreras_fotos/{photoId} {
      allow get: if true;
      allow list: if isAdmin() || resource.data.status == 'approved';
      allow delete: if isAdmin();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().size() <= 20
        && (!('caption' in request.resource.data) || (request.resource.data.caption is string && request.resource.data.caption.size() <= 500 && !request.resource.data.caption.matches('.*(?i)<script.*')))
        && (!('author' in request.resource.data) || (request.resource.data.author is string && request.resource.data.author.size() <= 80 && !request.resource.data.author.matches('.*(?i)<script.*')));
    }

    match /fantasy_leaderboard/{teamId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isSignedIn()
        && !('email' in request.resource.data)
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() <= 40
        && !request.resource.data.teamName.matches('.*(?i)<script.*')
        && request.resource.data.teamValue is number
        && request.resource.data.teamValue <= 85;
    }

    match /fantasy_teams/{teamId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isSignedIn()
        && !('email' in request.resource.data)
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() <= 40
        && !request.resource.data.teamName.matches('.*(?i)<script.*')
        && request.resource.data.teamValue is number
        && request.resource.data.teamValue <= 85;
    }
  }
}
