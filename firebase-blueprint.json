{
  "entities": {
    "Pilot": {
      "title": "Pilot",
      "description": "Championship driver registered in the official roster",
      "type": "object",
      "properties": {
        "driver": {
          "type": "string",
          "description": "Name or handle of the driver"
        },
        "team": {
          "type": "string",
          "description": "Formula 1 constructor team"
        },
        "pts": {
          "type": "number",
          "description": "Championship points accumulated"
        },
        "pos": {
          "type": "number",
          "description": "Current position in standings"
        }
      },
      "required": ["driver", "team", "pts"]
    },
    "RaceResult": {
      "title": "RaceResult",
      "description": "Official results for a Grand Prix event",
      "type": "object",
      "properties": {
        "round": {
          "type": "string",
          "description": "Round identifier (e.g. ROUND 01)"
        },
        "title": {
          "type": "string",
          "description": "Grand Prix name"
        },
        "location": {
          "type": "string",
          "description": "Circuit location and country"
        },
        "date": {
          "type": "string",
          "description": "Race date text"
        },
        "winner": {
          "type": "string",
          "description": "Race winner"
        },
        "pole": {
          "type": "string",
          "description": "Pole position driver and lap time"
        },
        "fastest": {
          "type": "string",
          "description": "Fastest lap driver and time"
        },
        "driverDay": {
          "type": "string",
          "description": "Driver of the Day"
        }
      },
      "required": ["round", "title"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Application settings and countdown target",
      "type": "object",
      "properties": {
        "round": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "dateText": { "type": "string" },
        "dateTime": { "type": "string" }
      }
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "User profile and credentials synchronized across devices",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "FantasyTeam": {
      "title": "FantasyTeam",
      "description": "User created FFC Fantasy team with chosen drivers, constructor, and real-time points",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "managerName": { "type": "string" },
        "email": { "type": "string" },
        "teamName": { "type": "string" },
        "driver1": { "type": "string" },
        "driver2": { "type": "string" },
        "driver3": { "type": "string" },
        "team": { "type": "string" },
        "turboDriver": { "type": "string" },
        "totalPoints": { "type": "number" },
        "teamValue": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "teamName"]
    },
    "NewsArticle": {
      "title": "NewsArticle",
      "description": "News article submitted by users or created by admins with approval status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorUid": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "approvedAt": { "type": "string" },
        "commentsCount": { "type": "number" }
      },
      "required": ["title", "content", "authorName", "status", "createdAt"]
    },
    "NewsComment": {
      "title": "NewsComment",
      "description": "User comment posted under an approved news article",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "newsId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorUid": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["newsId", "authorName", "text", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time chat room message posted by community members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorUid": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["authorName", "text", "createdAt"]
    }
  },
  "firestore": {
    "/pilotos/{pilotId}": {
      "schema": {
        "$ref": "#/entities/Pilot"
      },
      "description": "Collection storing all championship drivers and points in real time"
    },
    "/carreras/{raceId}": {
      "schema": {
        "$ref": "#/entities/RaceResult"
      },
      "description": "Collection of Grand Prix results"
    },
    "/configuracion/{configId}": {
      "schema": {
        "$ref": "#/entities/AppConfig"
      },
      "description": "General settings and upcoming race details"
    },
    "/usuarios/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "User accounts cloud collection synchronized for multi-device login"
    },
    "/fantasy_leaderboard/{teamId}": {
      "schema": {
        "$ref": "#/entities/FantasyTeam"
      },
      "description": "Public fantasy league leaderboard containing all user created teams with synchronized points"
    },
    "/noticias/{newsId}": {
      "schema": {
        "$ref": "#/entities/NewsArticle"
      },
      "description": "Championship news articles submitted by community and approved by admins"
    },
    "/noticias_comentarios/{commentId}": {
      "schema": {
        "$ref": "#/entities/NewsComment"
      },
      "description": "Public comments posted by community members under published news articles"
    },
    "/chat_mensajes/{msgId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Real-time chat messages room synced with Firebase"
    }
  }
}
